{
  "manifest_version": 3,
  "default_locale": "zh_CN",
  "name": "__MSG_extName__",
  "version": "2.2.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "102",

  "permissions": ["storage", "scripting"],
  "host_permissions": ["*://*.bilibili.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["floating.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "theme.js"],
      "matches": ["*://*.bilibili.com/*"]
    }
  ],

  "action": {
    "default_title": "BiliSpeed 倍速控制",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
